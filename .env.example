# Application
APP_ENV=development
LOG_LEVEL=INFO

# OpenRouter: leave the key and model IDs blank until explicitly configured.
OPENROUTER_API_KEY=
ALLOW_PAID_MODELS=false
PRIMARY_FREE_MODEL=
FALLBACK_FREE_MODEL_1=
FALLBACK_FREE_MODEL_2=

# Infrastructure: blank values are safe; adapters arrive in later phases.
DATABASE_URL=
REDIS_URL=

# Optional free-tier provider adapters; the platform must not require these.
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=

# Planned external-call safety defaults. Application validation comes later.
HTTP_TIMEOUT_SECONDS=30
MAX_HTTP_RETRIES=2

# Phase 3 market freshness/cache policy (fixture-backed by default).
MARKET_STALE_AFTER_HOURS=72
MARKET_CACHE_TTL_SECONDS=300

# Optional live market acquisition (Yahoo chart HTTP). Default OFF so local/CI
# remain offline and $0. When enabled, fixture remains secondary fallback.
MARKET_DATA_LIVE_ENABLED=false
MARKET_DATA_PRIMARY_PROVIDER=yahoo_finance_chart
MARKET_DATA_TIMEOUT_SECONDS=15
MARKET_DATA_MAX_RESPONSE_BYTES=1048576
MARKET_DATA_MAX_RETRIES=2
MARKET_DATA_HISTORY_DAYS=30

# Phase 4 financial freshness/cache policy (fixture-backed by default).
FINANCIAL_CACHE_TTL_SECONDS=3600

# Optional live SEC companyfacts acquisition. Default OFF so local/CI remain offline.
FINANCIAL_DATA_LIVE_ENABLED=false
FINANCIAL_DATA_PRIMARY_PROVIDER=sec_company_facts
FINANCIAL_DATA_TIMEOUT_SECONDS=15
FINANCIAL_DATA_MAX_RESPONSE_BYTES=2097152
FINANCIAL_DATA_MAX_RETRIES=2
